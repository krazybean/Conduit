{
  "name": "@krazybean/conduit",
  "version": "0.2.0",
  "description": "Conduit — lightweight AI driver for OpenAI-compatible, Ollama, Anthropic, Gemini (TypeScript)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krazybean/Conduit.git"
  },
  "homepage": "https://github.com/krazybean/Conduit",
  "keywords": [
    "ai",
    "llm",
    "openai",
    "ollama",
    "anthropic",
    "gemini"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
